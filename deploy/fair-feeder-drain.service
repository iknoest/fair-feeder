[Unit]
Description=Fair Feeder Local Morning Drain and Daytime Idle Transition
After=network-online.target

[Service]
Type=oneshot
User=pi5
WorkingDirectory=/home/pi5/Feeder/fair-feeder
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/pi5/Feeder/fair-feeder/.env
ExecStart=/home/pi5/Feeder/fair-feeder/.venv/bin/python scripts/lifecycle_manager.py drain-and-idle --max-wait-sec 900
